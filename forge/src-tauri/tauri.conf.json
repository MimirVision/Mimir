{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimir Forge",
  "version": "0.1.0",
  "identifier": "com.mimir.forge",
  "mainBinaryName": "mimir-forge",
  "build": {
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node ./node_modules/vite/bin/vite.js build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$APPLOCALDATA/**",
            "C:/MimirDev/backend/**"
          ],
          "deny": [
            "**/.git/**",
            "**/.env*"
          ],
          "requireLiteralLeadingDot": true
        }
      },
      "capabilities": [
        "main-capability"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Mimir Forge",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "copyright": "Copyright Mimir",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "longDescription": "Developer console for the Mimir training ground -- sync submissions, review feedback, browse collections.",
    "publisher": "Mimir",
    "shortDescription": "Mimir training ground console",
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
