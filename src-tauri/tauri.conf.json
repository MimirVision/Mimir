{
  "package": {
    "productName": "Mimir",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node ./node_modules/vite/bin/vite.js build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true
      },
      "fs": {
        "readFile": true,
        "scope": [
          "C:\\Mimir_Backend\\MimirOutput\\latest_session.json"
        ]
      },
      "protocol": {
        "asset": true,
        "assetScope": [
          "C:\\Mimir_Backend\\Frames\\*"
        ]
      },
      "shell": {
        "sidecar": true,
        "scope": [
          {
            "name": "binaries/mimir-api",
            "sidecar": true
          }
        ]
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "",
      "externalBin": [
        "binaries/mimir-api"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "identifier": "com.mimir.scanner",
      "longDescription": "Local incident review for vehicle and dashcam footage.",
      "shortDescription": "Dashcam incident scanner",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 760,
        "resizable": true,
        "title": "Mimir",
        "width": 1180
      }
    ]
  }
}
