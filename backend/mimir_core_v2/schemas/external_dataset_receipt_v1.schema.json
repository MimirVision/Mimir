{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.local/schemas/external_dataset_receipt_v1.schema.json",
  "title": "Mimir external dataset source receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source_id",
    "repository",
    "repository_revision",
    "license_accepted",
    "license_accepted_by",
    "license_acceptance_basis",
    "license_url",
    "retrieved_at"
  ],
  "properties": {
    "schema_version": {"const": "mimir_external_dataset_receipt_v1"},
    "source_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "license_accepted": {"const": true},
    "license_accepted_by": {"type": "string", "minLength": 1},
    "license_acceptance_basis": {"type": "string", "minLength": 1},
    "license_url": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "include_footage": {"type": "boolean"},
    "include_evaluation_footage": {"type": "boolean"},
    "inventories": {"type": "object"}
  }
}
